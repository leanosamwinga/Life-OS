# Copy to apps/mobile/.env.local (git-ignored). Only EXPO_PUBLIC_* values reach the app bundle,
# so never put secrets here — the anon key is public by design and protected by RLS.
# Without these the app still starts and shows a "Not connected" banner with sample data.

# Local: printed by `supabase start` (API URL and anon key)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# On a phone, 127.0.0.1 is the phone itself: use your Mac's Wi-Fi address instead,
# e.g. EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.128:54321 (find it with `ipconfig getifaddr en0`).
# Newer Supabase CLIs call the anon key the "Publishable" key — use that one, never the Secret key.

# Device checks (decision 8): "off" for Expo Go and local development. On in production.
EXPO_PUBLIC_DEVICE_CHECKS=off
# Cloudflare Turnstile SITE key for the web app (public). The secret key is an auth-api secret.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=

# Sign in with Google / Apple. Public client ids, not secrets.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_APPLE_SERVICES_ID=
EXPO_PUBLIC_APPLE_WEB_REDIRECT_URI=

# Web cookie server (src/app/api/**+api.ts) — read on the server only, never bundled.
# Default to the EXPO_PUBLIC_ values above; WEB_ORIGIN defaults to the request's origin.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# WEB_ORIGIN=https://app.example.test
