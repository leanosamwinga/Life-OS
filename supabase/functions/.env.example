# auth-api secrets. Copy to supabase/functions/.env (git-ignored) for `supabase functions serve`,
# and set the same names as edge function secrets in the hosted project. NEVER commit real values.
# Generate random secrets with: openssl rand -base64 48

# Password pepper (spec 5.4). Add AUTH_PASSWORD_PEPPER_V2 etc. to rotate; the highest version is
# current and old ones keep working until each account signs in again (rehash on sign-in).
# The value below is the documented LOCAL-ONLY default the seed account uses. Use a real random
# secret in the hosted project.
AUTH_PASSWORD_PEPPER_V1=local-dev-pepper-NOT-A-SECRET
AUTH_CODE_HMAC_KEY=
AUTH_KEY_HASH_KEY=
AUTH_LOG_HMAC_KEY=
AUTH_TOKEN_ENC_KEY=
AUTH_JOB_SECRET=

# Device checks (decision 8): "off" for Expo Go and local development, on otherwise.
AUTH_DEVICE_CHECKS=off
# Breach check against public.auth_breached_hashes (fake fixture locally): "off" to skip.
AUTH_BREACH_CHECK=on
# Look-up timing floor in ms (spec 6.3). 600 in production; 0 makes local tests fast.
AUTH_TIMING_FLOOR_MS=600

# Cloudflare Turnstile (web). Secret key from the Cloudflare dashboard.
TURNSTILE_SECRET_KEY=
# App Attest (iPhone): <TeamID>.<bundle id>, comma-separated.
APP_ATTEST_APP_IDS=

# Google: client IDs whose ID tokens we accept (iOS, web), comma-separated. Not secrets.
GOOGLE_CLIENT_IDS=
# Apple: bundle ID (native) and Services ID (web). Not secrets.
APPLE_BUNDLE_ID=
APPLE_SERVICES_ID=
# Apple Sign in key for the code exchange and revocation (spec 9.2). The .p8 contents are a SECRET.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Web origins allowed to call auth-api (the web server in front of the app).
AUTH_ALLOWED_ORIGINS=http://localhost:8081
AUTH_RESET_LINK_BASE=https://lifeos.app/reset

# Local only: send email through Mailpit (http://127.0.0.1:54324). Unset in the hosted project.
MAILPIT_URL=http://host.docker.internal:54324
