# Copy to supabase/.env (git-ignored) for `supabase start` / `supabase functions serve`.
# Never commit real values.

# Sign in with Apple. CLIENT_ID is a comma-separated list: the iOS bundle id (native sign-in)
# and the Services ID (web/Android OAuth). SECRET is the client-secret JWT generated from your
# Apple Sign in key (it expires every 6 months; regenerate it).
#
# LOCAL ONLY — to try Apple sign-in inside Expo Go, also allow Expo Go's bundle id
# (host.exp.Exponent). Never add it to the hosted project. Restart with `npx supabase stop && npx supabase start`.
#   SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=com.example.lifeos,host.exp.Exponent
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=com.example.lifeos,com.example.lifeos.web
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=

# Sign in with Google: Web client id first, then the iOS and Android client ids, comma-separated.
# The secret is the Web client's secret.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Edge functions get SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY
# injected automatically by the Supabase runtime; do not set them here.

# Used by scripts/test-db.sh when running database tests against a plain Postgres.
# DATABASE_URL=postgresql://postgres@localhost:5432/lifeos_test
