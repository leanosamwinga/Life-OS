{
  "name": "life-os",
  "private": true,
  "version": "0.1.0",
  "description": "Life OS \u2014 one calm place for health, money, plans and reflection.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build:core": "npm run build -w @life-os/core",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run build:core && tsc -b packages/core supabase/functions && npm run typecheck -w @life-os/mobile",
    "test": "npm run test:core && npm run test:functions && npm run test:mobile",
    "test:core": "npm run test -w @life-os/core",
    "test:functions": "vitest run --root supabase/functions",
    "test:mobile": "npm run test -w @life-os/mobile",
    "test:db": "bash scripts/test-db.sh",
    "mobile": "npm run start -w @life-os/mobile"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.0.0",
    "prettier": "^3.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.1.0",
    "@types/node": "^24.0.0"
  }
}
